{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('hostUid').val() === auth.uid) || (data.exists() && data.child('hostUid').val() === auth.uid && (!newData.exists() || newData.child('hostUid').val() === auth.uid || root.child('members').child($code).child(newData.child('hostUid').val()).exists())))",
        ".validate": "newData.hasChildren(['hostUid', 'createdAt', 'hostOnlyControl'])"
      }
    },
    "members": {
      "$code": {
        ".read": "auth != null && root.child('rooms').child($code).exists()",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && (data.exists() || root.child('members').child($code).numChildren() < 5)",
          ".validate": "newData.hasChildren(['uid', 'displayName', 'joinedAt', 'connected']) && newData.child('uid').val() === auth.uid && newData.child('displayName').isString() && newData.child('displayName').val().length <= 40 && newData.child('joinedAt').isNumber() && newData.child('connected').isBoolean()"
        }
      }
    },
    "playback": {
      "$code": {
        ".read": "auth != null && root.child('members').child($code).child(auth.uid).exists()",
        ".write": "auth != null && root.child('members').child($code).child(auth.uid).exists() && (!root.child('rooms').child($code).child('hostOnlyControl').val() || root.child('rooms').child($code).child('hostUid').val() === auth.uid)",
        ".validate": "newData.hasChildren(['seq', 'positionMs', 'anchorMs', 'isPlaying'])"
      }
    },
    "queues": {
      "$code": {
        ".read": "auth != null && root.child('members').child($code).child(auth.uid).exists()",
        ".write": "auth != null && root.child('members').child($code).child(auth.uid).exists() && (!root.child('rooms').child($code).child('hostOnlyControl').val() || root.child('rooms').child($code).child('hostUid').val() === auth.uid)",
        ".validate": "newData.child('index').isNumber()"
      }
    }
  }
}