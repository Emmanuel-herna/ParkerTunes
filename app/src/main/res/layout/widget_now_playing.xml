<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:padding="12dp" android:background="#1B1B1B">
    <ImageView android:id="@+id/widget_art" android:layout_width="44dp" android:layout_height="44dp"
        android:src="@android:drawable/ic_media_play" android:contentDescription="Album art" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp">
        <TextView android:id="@+id/widget_title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="ParkerTunes" android:textColor="#FFFFFF"
            android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:textSize="13sp" />
        <TextView android:id="@+id/widget_artist" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Nothing playing" android:textColor="#B8B8B8"
            android:maxLines="1" android:ellipsize="end" android:textSize="11sp" />
    </LinearLayout>
    <ImageButton android:id="@+id/widget_previous" android:layout_width="36dp" android:layout_height="44dp"
        android:background="@android:color/transparent" android:src="@android:drawable/ic_media_previous"
        android:contentDescription="Previous" />
    <ImageButton android:id="@+id/widget_play_pause" android:layout_width="40dp" android:layout_height="44dp"
        android:background="@android:color/transparent" android:src="@android:drawable/ic_media_play"
        android:contentDescription="Play or pause" />
    <ImageButton android:id="@+id/widget_next" android:layout_width="36dp" android:layout_height="44dp"
        android:background="@android:color/transparent" android:src="@android:drawable/ic_media_next"
        android:contentDescription="Next" />
</LinearLayout>